{
  "name": "n8n-nodes-lindo",
  "version": "1.5.1",
  "description": "n8n community node for Lindo.ai \u2014 automate website and client management with triggers and actions.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "lindo",
    "website",
    "website builder",
    "automation",
    "client management"
  ],
  "license": "MIT",
  "author": {
    "name": "Lindo.ai",
    "email": "saeedmshdi@gmail.com",
    "url": "https://lindo.ai"
  },
  "homepage": "https://lindo.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lindoai/n8n-nodes-lindo.git"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "rm -rf dist && node node_modules/typescript/bin/tsc && mkdir -p dist/nodes/Lindo dist/credentials && cp nodes/Lindo/*.svg dist/nodes/Lindo/ && cp nodes/Lindo/*.svg dist/credentials/",
    "lint": "n8n-node lint",
    "prepublishOnly": "npm test && npm run review",
    "test": "npm run build && node --test tests/*.test.cjs",
    "review": "npm run lint && node scripts/review.mjs"
  },
  "files": [
    "dist",
    "templates"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/LindoApi.credentials.js",
      "dist/credentials/LindoOAuth2Api.credentials.js",
      "dist/credentials/LindoFormWebhookApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Lindo/Lindo.node.js",
      "dist/nodes/Lindo/LindoTrigger.node.js",
      "dist/nodes/Lindo/LindoFormTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.23.1",
    "@n8n/scan-community-package": "0.38.0",
    "@types/node": "^20.0.0",
    "eslint": "^10.2.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.6",
    "n8n-workflow": "^1.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
